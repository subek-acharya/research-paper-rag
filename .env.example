# Research Paper RAG — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ============================================================
# Application Settings
# ============================================================
APP_NAME=research-paper-rag
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ============================================================
# API Settings
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000

